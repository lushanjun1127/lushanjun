{
  "name": "lushanjun/lushanjun-theme",
  "description": "陆山君の主题 - WordPress Theme",
  "type": "wordpress-theme",
  "keywords": ["wordpress", "theme", "blog"],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "陆山君",
      "email": "lushanjun@proton.me"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/wp-test-utils": "^1.2",
    "wp-coding-standards/wpcs": "^2.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Lushanjun\\Theme\\": "inc/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lushanjun\\Theme\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html ./coverage-report",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcbf": "phpcbf --standard=phpcs.xml",
    "i18n:pot": "wp i18n make-pot . languages/lushanjun-theme.pot",
    "i18n:check": "wp i18n check-textdomain --domain=lushanjun-theme"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
